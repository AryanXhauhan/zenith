{
	"info": {
		"name": "Zenith Settlement Engine - Automated Tests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Setup - Create Source Account",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Account Created\", function () { pm.response.to.have.status(200); });",
							"pm.environment.set(\"source_account\", pm.response.json().accountNumber);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "X-Zenith-Key", "value": "dev-master-key-changeme" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\"accountNumber\": \"ZNT-POSTMAN-001\", \"accountName\": \"Postman Source\", \"currency\": \"USD\", \"ownerId\": \"postman-test\"}",
					"options": { "raw": { "language": "json" } }
				},
				"url": { "raw": "http://localhost:8080/api/v1/accounts" }
			}
		},
		{
			"name": "2. Atomic Transfer with Idempotency",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.environment.set(\"tx_key\", \"idemp-\" + Math.random().toString(36).substring(7));"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Transfer Successful\", function () { pm.response.to.have.status(200); });",
							"pm.test(\"Status is COMPLETED\", function () { pm.expect(pm.response.json().status).to.eql(\"COMPLETED\"); });"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "X-Zenith-Key", "value": "dev-master-key-changeme" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"idempotencyKey\": \"{{tx_key}}\",\n    \"sourceAccountNumber\": \"ZNT-POSTMAN-001\",\n    \"destinationAccountNumber\": \"ZNT-002\",\n    \"amount\": 100.00,\n    \"currency\": \"USD\",\n    \"description\": \"Postman Automation Test\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": { "raw": "http://localhost:8080/api/v1/ledger/transfer" }
			}
		},
		{
			"name": "3. Verify Idempotency (Repeat Previous)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status 200 (Replayed)\", function () { pm.response.to.have.status(200); });",
							"pm.test(\"Header has Replay Flag\", function () { pm.expect(pm.response.headers.get(\"X-Idempotency-Replay\")).to.eql(\"true\"); });"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "X-Zenith-Key", "value": "dev-master-key-changeme" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"idempotencyKey\": \"{{tx_key}}\",\n    \"sourceAccountNumber\": \"ZNT-POSTMAN-001\",\n    \"destinationAccountNumber\": \"ZNT-002\",\n    \"amount\": 100.00,\n    \"currency\": \"USD\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": { "raw": "http://localhost:8080/api/v1/ledger/transfer" }
			}
		}
	]
}
